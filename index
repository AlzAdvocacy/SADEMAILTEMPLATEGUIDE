<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Build an Email Template in Quorum</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;">

<!-- =================================================================
     COPY EVERYTHING BETWEEN THESE TWO MARKERS INTO YOUR CUSTOM BOX.
     Nothing loads from the internet. Every style is scoped to
     #qsim-root so it will not touch anything else on the host page.
     ================================================================= -->

<div id="qsim-root" role="application" aria-label="Quorum email template walkthrough">
<style>
#qsim-root *,#qsim-root *::before,#qsim-root *::after{box-sizing:border-box}
#qsim-root{
  --ind:#5145CD; --ind-d:#4338B8; --blu:#2D8CFF; --blu-d:#1F6FD8;
  --gry:#6B7280; --bg:#F5F4FE; --ink:#1F2937; --mut:#6E7488;
  --line:#E4E2F2; --line2:#D8D6E8;
  --alz:#4A0D66; --alz-l:#6B2A8C; --gold:#F2A900; --red:#C0392B;
  position:fixed; inset:0; z-index:2147483000;
  background:var(--bg); color:var(--ink);
  font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:1.45;
  overflow:hidden; -webkit-font-smoothing:antialiased;
}
#qsim-root button{font-family:inherit;font-size:inherit;cursor:pointer;border:0;background:none;color:inherit}
#qsim-root :focus-visible{outline:3px solid var(--gold);outline-offset:2px}

/* ---------- splash ---------- */
#qsim-root .sp{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;background:#2C0640}
#qsim-root .sp-in{display:flex;width:min(1080px,100%);max-height:100%;background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.35)}
#qsim-root .sp-l{flex:1 1 46%;background:var(--alz);color:#fff;padding:clamp(20px,3.2vh,40px) clamp(22px,3vw,40px);display:flex;flex-direction:column;justify-content:center}
#qsim-root .sp-eyebrow{font-size:clamp(10px,1.3vh,12px);font-weight:bold;letter-spacing:.09em;color:#E6C9F5;margin:0 0 10px}
#qsim-root .sp-l h1{font-size:clamp(22px,3.6vh,34px);line-height:1.15;margin:0 0 14px;font-weight:bold}
#qsim-root .sp-l p{font-size:clamp(12px,1.7vh,15px);margin:0 0 12px;color:#F0E4F7;max-width:44ch}
#qsim-root .sp-meta{margin-top:14px;padding-top:14px;border-top:1px solid rgba(255,255,255,.25);font-size:clamp(11px,1.5vh,13px);color:#DDBDEF}
#qsim-root .sp-r{flex:1 1 54%;padding:clamp(20px,3.2vh,40px) clamp(22px,3vw,40px);display:flex;flex-direction:column;justify-content:center;overflow:auto}
#qsim-root .sp-r h2{font-size:clamp(14px,2vh,17px);color:var(--alz);margin:0 0 12px}
#qsim-root .sp-r ol{margin:0 0 18px;padding-left:20px}
#qsim-root .sp-r li{font-size:clamp(12px,1.6vh,14px);margin-bottom:9px}
#qsim-root .sp-note{background:#FBF6FE;border-left:4px solid var(--alz);padding:11px 13px;font-size:clamp(11px,1.5vh,13px);margin-bottom:18px}
#qsim-root .sp-go{align-self:flex-start;background:var(--alz);color:#fff;font-weight:bold;padding:13px 30px;border-radius:6px;font-size:clamp(13px,1.8vh,15px)}
#qsim-root .sp-go:hover{background:var(--alz-l)}

/* ---------- app shell ---------- */
#qsim-root .app{position:absolute;inset:0;display:none;flex-direction:column;background:var(--bg)}
#qsim-root .app.on{display:flex}
#qsim-root .topbar{height:56px;flex:0 0 56px;display:flex;align-items:center;gap:14px;padding:0 18px;background:var(--bg);border-bottom:1px solid var(--line)}
#qsim-root .qlogo{width:30px;height:30px;flex:0 0 30px}
#qsim-root .tb-region{display:flex;align-items:center;gap:6px;color:var(--ink);font-size:13px;white-space:nowrap}
#qsim-root .tb-search{flex:1 1 auto;max-width:640px;height:34px;background:#EDEBFA;border-radius:18px;display:flex;align-items:center;gap:8px;padding:0 14px;color:#8A8FA3;font-size:13px}
#qsim-root .tb-right{margin-left:auto;display:flex;align-items:center;gap:10px}
#qsim-root .tb-plus{width:30px;height:30px;border-radius:50%;background:#E4E1FA;display:flex;align-items:center;justify-content:center;color:var(--ind);font-size:18px}
#qsim-root .tb-quincy{background:#F5E9C9;border-radius:16px;padding:6px 13px;font-size:13px;font-weight:bold;color:#4A3A12;white-space:nowrap}
#qsim-root .tb-ic{color:#5C6070}

#qsim-root .body{flex:1 1 auto;display:flex;min-height:0}
#qsim-root .side{width:60px;flex:0 0 60px;background:var(--bg);display:flex;flex-direction:column;align-items:center;padding:10px 0;gap:4px;border-right:1px solid var(--line)}
#qsim-root .nav{width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#4C5162;position:relative}
#qsim-root .nav:hover{background:#E9E6FA}
#qsim-root .nav.act{background:#EDE9FB;color:var(--ind)}
#qsim-root .nav.gold{background:#F5E9C9;color:#7A5B0A}
#qsim-root .nav-div{width:26px;height:1px;background:var(--line2);margin:7px 0}
#qsim-root .tt{position:absolute;left:46px;top:50%;transform:translateY(-50%);background:#1F2430;color:#fff;font-size:12px;padding:4px 9px;border-radius:4px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .12s}
#qsim-root .nav:hover .tt{opacity:1}

#qsim-root .main{flex:1 1 auto;min-width:0;padding:14px;overflow:auto}
#qsim-root .panel{background:#fff;border-radius:10px;min-height:100%;padding:22px 26px;box-shadow:0 1px 3px rgba(30,20,80,.06)}

/* ---------- dashboard ---------- */
#qsim-root .dash-h{display:flex;align-items:center;gap:14px;margin-bottom:18px}
#qsim-root .dash-h h2{margin:0;font-size:20px}
#qsim-root .dash-h .sp2{margin-left:auto;display:flex;gap:16px;align-items:center;font-size:13px;color:#3A3F52}
#qsim-root .dash-grid{display:grid;grid-template-columns:1.9fr 1.1fr;gap:14px}
#qsim-root .card{border:1px solid var(--line);border-radius:8px;padding:16px}
#qsim-root .card h3{margin:0 0 8px;color:var(--ind);font-size:17px;letter-spacing:.02em}
#qsim-root .card p{margin:0 0 8px;font-size:13px}
#qsim-root .res b{display:block;margin-bottom:5px;font-size:13px}
#qsim-root .res a{display:block;color:var(--ind);font-size:13px;margin-bottom:3px;text-decoration:none}
#qsim-root .stat{border:1px solid var(--line);border-radius:8px;padding:14px;text-align:center}
#qsim-root .stat .n{font-size:34px;font-weight:bold;color:var(--ind);line-height:1.1}
#qsim-root .stat .l{font-size:13px;color:#5B6070}
#qsim-root .maptile{display:grid;grid-template-columns:repeat(11,1fr);gap:3px;margin-top:10px}
#qsim-root .maptile i{display:block;padding-bottom:70%;border-radius:2px;background:#E9E4F4}

/* ---------- generic table ---------- */
#qsim-root .tbl{width:100%;border-collapse:collapse;font-size:13px}
#qsim-root .tbl th{text-align:left;font-size:12px;color:#3A3F52;padding:9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
#qsim-root .tbl td{padding:11px 10px;border-bottom:1px solid #F0EEF8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#qsim-root .tbl tr.alt td{background:#FAF9FE}
#qsim-root .tbl .num{text-align:right;font-weight:bold}
#qsim-root .btn{border-radius:6px;padding:8px 14px;font-size:13px;display:inline-flex;align-items:center;gap:7px;white-space:nowrap}
#qsim-root .btn-ind{background:var(--ind);color:#fff;font-weight:bold}
#qsim-root .btn-ind:hover{background:var(--ind-d)}
#qsim-root .btn-out{border:1px solid var(--line2);background:#fff;color:#2A2F40}
#qsim-root .btn-out:hover{background:#F6F5FC}
#qsim-root .btn-blu{background:var(--blu);color:#fff;font-weight:bold}
#qsim-root .btn-blu:hover{background:var(--blu-d)}
#qsim-root .btn-gry{background:var(--gry);color:#fff;font-weight:bold}
#qsim-root .pill{border-radius:16px;padding:6px 14px;font-size:13px}
#qsim-root .pill.on{background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.14);font-weight:bold}
#qsim-root .tabs{background:#EFEDF8;border-radius:18px;padding:4px;display:inline-flex;gap:2px}
#qsim-root .srch{border:1px solid var(--line2);border-radius:5px;height:36px;display:flex;align-items:center;padding:0 12px;color:#9095A8;font-size:13px;min-width:230px}

/* ---------- create template modal ---------- */
#qsim-root .ovl{position:absolute;inset:0;background:rgba(30,24,60,.42);display:none;align-items:center;justify-content:center;padding:20px;z-index:40}
#qsim-root .ovl.on{display:flex}
#qsim-root .modal{background:#fff;border-radius:8px;width:100%;height:100%;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(0,0,0,.3)}
#qsim-root .modal-h{display:flex;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line)}
#qsim-root .modal-h h3{margin:0;font-size:19px}
#qsim-root .modal-b{padding:18px 20px;overflow:auto}
#qsim-root .tgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
#qsim-root .tcard{border:1px solid #CFCBEA;border-radius:5px;overflow:hidden;text-align:center}
#qsim-root .tcard .th{background:var(--ind);padding:40px 0;display:flex;justify-content:center}
#qsim-root .tcard .sheet{width:74px;height:98px;background:#F0EFF3;border-radius:2px;padding:11px 9px}
#qsim-root .tcard .sheet i{display:block;height:6px;background:#D3D2DA;margin-bottom:6px;border-radius:1px}
#qsim-root .tcard .sheet i.blk{height:38px}
#qsim-root .tcard .tn{background:#F1F0F6;padding:13px 6px;font-size:14px}
#qsim-root .blanks{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
#qsim-root .blank{border:1px solid var(--line2);border-radius:5px;padding:18px;text-align:center;font-size:15px;color:#2A2F40;background:#fff}
#qsim-root .blank:hover{background:#F6F5FC}

/* ---------- editor ---------- */
#qsim-root .ed{position:absolute;inset:0;background:#fff;display:none;flex-direction:column;z-index:30}
#qsim-root .ed.on{display:flex}
#qsim-root .ed-top{flex:0 0 auto;display:flex;align-items:flex-end;gap:12px;padding:12px 18px 14px;border-bottom:1px solid var(--line);flex-wrap:wrap}
#qsim-root .ed-name{display:flex;flex-direction:column;gap:5px}
#qsim-root .ed-name span{font-size:14px;font-weight:bold}
#qsim-root .ed-name input{width:330px;height:38px;border:1px solid var(--line2);border-radius:5px;padding:0 12px;font-size:14px;font-family:inherit;color:var(--ink)}
#qsim-root .ed-tools{display:flex;align-items:center;gap:8px;padding-bottom:1px}
#qsim-root .ed-right{margin-left:auto;display:flex;gap:9px;padding-bottom:1px}
#qsim-root .ed-body{flex:1 1 auto;display:flex;min-height:0;position:relative}
#qsim-root .canvas{flex:1 1 auto;min-width:0;background:#fff;overflow:auto;padding:22px}
#qsim-root .sheet-w{max-width:640px;margin:0 auto}
#qsim-root .drop{border:2px dashed #A8CBEF;background:#EAF3FC;border-radius:4px;padding:34px;text-align:center;color:var(--blu);font-size:14px;font-weight:bold}
#qsim-root .blk{position:relative;border:1px solid transparent}
#qsim-root .blk.sel{border-color:var(--blu)}
#qsim-root .blk-tag{position:absolute;right:0;bottom:-19px;background:var(--blu);color:#fff;font-size:11px;padding:2px 9px;border-radius:0 0 3px 3px;display:none}
#qsim-root .blk.sel .blk-tag{display:block}
#qsim-root .imgph{border:2px dashed #C6C3DC;background:#FAFAFE;border-radius:4px;padding:26px;text-align:center;color:#6E7488;font-size:13px}
#qsim-root .imgph .brw{margin-top:11px;display:inline-block;background:var(--blu);color:#fff;font-weight:bold;padding:8px 20px;border-radius:5px}
#qsim-root .banner{display:block;width:100%}
#qsim-root .etext{padding:12px 10px;font-size:14px;color:#3A3325;line-height:1.55;min-height:44px}
#qsim-root .etext p{margin:0 0 11px}
#qsim-root .etext p:last-child{margin-bottom:0}
#qsim-root .caret{display:inline-block;width:1px;height:15px;background:#3A3325;vertical-align:-3px;animation:qsblink 1s steps(1) infinite}
@keyframes qsblink{50%{opacity:0}}
#qsim-root .ebtn-wrap{padding:14px 10px;text-align:center}
#qsim-root .ebtn{display:inline-block;background:#3aaee0;color:#fff;padding:13px 26px;border-radius:4px;font-size:14px}
#qsim-root .ebtn.b{font-weight:bold}

#qsim-root .rail{width:330px;flex:0 0 330px;border-left:1px solid var(--line);background:#fff;display:flex;flex-direction:column;min-height:0}
#qsim-root .rail-tabs{display:flex;flex:0 0 auto}
#qsim-root .rtab{flex:1;padding:14px 4px;text-align:center;font-size:13px;font-weight:bold;color:#3A3F52;background:#EEECF6;border-bottom:1px solid var(--line);letter-spacing:.03em}
#qsim-root .rtab.on{background:#fff;border-bottom-color:#fff}
#qsim-root .rail-b{flex:1 1 auto;overflow:auto;min-height:0}
#qsim-root .bgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:11px;padding:14px}
#qsim-root .bcard{border:1px solid var(--line2);border-radius:6px;padding:14px 4px 10px;text-align:center;background:#fff}
#qsim-root .bcard:hover{border-color:var(--blu);background:#F7FBFF}
#qsim-root .bcard .bl{display:block;font-size:11px;margin-top:7px;color:#3A3F52;font-weight:bold;letter-spacing:.03em}
#qsim-root .prop-h{background:#fff;padding:14px 16px;display:flex;align-items:center;border-bottom:1px solid var(--line)}
#qsim-root .prop-h b{font-size:13px;letter-spacing:.03em}
#qsim-root .prop-h .ph-ic{margin-left:auto;display:flex;gap:2px;color:#5C6070}
#qsim-root .sec-h{background:#EEECF6;padding:10px 16px;font-size:12px;font-weight:bold;letter-spacing:.05em;color:#3A3F52}
#qsim-root .frow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-bottom:1px solid #F0EEF8}
#qsim-root .frow>label{font-size:13px;color:#2A2F40}
#qsim-root .fin{border:1px solid var(--line2);border-radius:5px;height:36px;display:flex;align-items:center;overflow:hidden;flex:1 1 auto;max-width:200px}
#qsim-root .fin .tag{background:#F4F3F9;border-right:1px solid var(--line2);padding:0 10px;height:100%;display:flex;align-items:center;font-size:13px;color:#5C6070}
#qsim-root .fin input{border:0;height:100%;width:100%;padding:0 10px;font-size:13px;font-family:inherit;color:var(--ink);background:#fff}
#qsim-root .swatch{width:22px;height:22px;border-radius:3px;border:1px solid #CFCDDE;flex:0 0 22px;margin-left:8px}
#qsim-root .sel-box{border:1px solid var(--line2);border-radius:5px;height:36px;display:flex;align-items:center;justify-content:space-between;padding:0 10px;font-size:13px;min-width:150px}
#qsim-root .tog{width:44px;height:23px;border-radius:12px;background:var(--blu);position:relative;flex:0 0 44px}
#qsim-root .tog i{position:absolute;top:2px;right:2px;width:19px;height:19px;border-radius:50%;background:#fff}
#qsim-root .stepper{border:1px solid var(--line2);border-radius:5px;display:flex;align-items:center;overflow:hidden}
#qsim-root .stepper span{padding:0 12px;height:34px;display:flex;align-items:center;font-size:13px}
#qsim-root .stepper b{padding:0 10px;height:34px;display:flex;align-items:center;border-left:1px solid var(--line2);border-right:1px solid var(--line2);font-weight:normal}

/* ---------- dropdown ---------- */
#qsim-root .dd{position:absolute;top:62px;right:340px;width:330px;background:#fff;border:2px solid var(--ind);border-radius:6px;box-shadow:0 12px 30px rgba(0,0,0,.2);display:none;z-index:45;overflow:hidden}
#qsim-root .dd.on{display:block}
#qsim-root .dd-s{padding:12px 14px;color:#9095A8;font-style:italic;font-size:13px;border-bottom:1px solid var(--line)}
#qsim-root .dd-l{max-height:250px;overflow:auto;padding:6px 0}
#qsim-root .dd-i{display:block;width:100%;text-align:left;padding:9px 16px;font-size:14px;color:var(--ind)}
#qsim-root .dd-i:hover{background:#F1EEFC}
#qsim-root .dd-g{padding:9px 16px 5px;font-size:12px;font-weight:bold;color:#8A8FA3;letter-spacing:.05em}

/* ---------- file manager ---------- */
#qsim-root .fm{position:absolute;inset:0;background:#fff;display:none;flex-direction:column;z-index:44;border-top:1px solid var(--line)}
#qsim-root .fm.on{display:flex}
#qsim-root .fm-h{display:flex;align-items:center;gap:12px;padding:16px 22px;border-bottom:1px solid var(--line)}
#qsim-root .fm-h h3{margin:0;font-size:19px;margin-right:6px}
#qsim-root .fm-bar{display:flex;align-items:center;gap:12px;padding:14px 22px;border-bottom:1px solid var(--line)}
#qsim-root .fm-home{width:42px;height:42px;border-radius:50%;background:#F2F0FA;display:flex;align-items:center;justify-content:center;color:#3A3F52}
#qsim-root .fm-b{flex:1 1 auto;overflow:auto;padding:0 22px 22px}
#qsim-root .fm-th{display:grid;grid-template-columns:26px 1.6fr 1fr .8fr .8fr;gap:10px;padding:13px 6px;background:#F6F5FC;font-size:12px;font-weight:bold;color:#8A8FA3;letter-spacing:.04em;position:sticky;top:0}
#qsim-root .fgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding-top:16px}
#qsim-root .fcard{border:1px solid var(--line2);border-radius:6px;padding:13px;display:flex;gap:12px}
#qsim-root .fthumb{width:104px;height:78px;flex:0 0 104px;border-radius:3px;background:#EFEDF6;overflow:hidden}
#qsim-root .fmeta{flex:1 1 auto;min-width:0;display:flex;flex-direction:column}
#qsim-root .fmeta .d{font-size:12px;color:#5C6070}
#qsim-root .fmeta .n{font-size:14px;font-weight:bold;margin:3px 0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#qsim-root .fmeta .s{font-size:12px;color:#5C6070}
#qsim-root .fmeta .row{margin-top:auto;display:flex;align-items:center;gap:10px;padding-top:10px;border-top:1px solid #F0EEF8;color:#5C6070}
#qsim-root .fmeta .row .btn{margin-left:auto;padding:7px 18px}

/* ---------- windows file picker ---------- */
#qsim-root .wfd{position:absolute;inset:0;background:rgba(20,16,40,.34);display:none;align-items:center;justify-content:center;z-index:55}
#qsim-root .wfd.on{display:flex}
#qsim-root .wfd-box{width:min(820px,94%);height:min(560px,92%);background:#F0F0F0;border:1px solid #A0A0A0;box-shadow:0 18px 44px rgba(0,0,0,.4);display:flex;flex-direction:column;font-size:13px;color:#111}
#qsim-root .wfd-title{background:#FFFFFF;border-bottom:1px solid #DADADA;padding:9px 12px;display:flex;align-items:center;font-weight:bold;font-size:13px}
#qsim-root .wfd-title span:last-child{margin-left:auto;color:#555;font-weight:normal}
#qsim-root .wfd-bar{display:flex;align-items:center;gap:7px;padding:8px 12px;background:#F0F0F0;border-bottom:1px solid #DADADA}
#qsim-root .wfd-nav{color:#555;width:22px;text-align:center}
#qsim-root .wfd-crumb{flex:1 1 auto;background:#fff;border:1px solid #ABADB3;padding:5px 9px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
#qsim-root .wfd-srch{width:170px;background:#fff;border:1px solid #ABADB3;padding:5px 9px;color:#8A8A8A;overflow:hidden;white-space:nowrap}
#qsim-root .wfd-body{flex:1 1 auto;display:flex;min-height:0;background:#fff;border-bottom:1px solid #DADADA}
#qsim-root .wfd-side{width:180px;flex:0 0 180px;border-right:1px solid #E4E4E4;padding:8px 0;overflow:auto;background:#fff}
#qsim-root .wfd-si{padding:5px 12px;color:#222;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#qsim-root .wfd-si.on{background:#CCE8FF}
#qsim-root .wfd-list{flex:1 1 auto;overflow:auto;padding:4px 0}
#qsim-root .wfd-row{display:flex;align-items:center;gap:10px;padding:6px 12px;cursor:default}
#qsim-root .wfd-row:hover{background:#E5F3FF}
#qsim-root .wfd-row.sel{background:#CCE8FF}
#qsim-root .wfd-th{width:34px;height:26px;flex:0 0 34px;border:1px solid #C8C8C8}
#qsim-root .wfd-nm{flex:1 1 auto;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
#qsim-root .wfd-dt{width:150px;flex:0 0 150px;color:#555}
#qsim-root .wfd-sz{width:70px;flex:0 0 70px;color:#555;text-align:right}
#qsim-root .wfd-foot{padding:11px 12px;display:flex;align-items:center;gap:9px;background:#F0F0F0}
#qsim-root .wfd-foot label{white-space:nowrap}
#qsim-root .wfd-fn{flex:1 1 auto;background:#fff;border:1px solid #ABADB3;padding:5px 9px;min-height:26px;overflow:hidden;white-space:nowrap}
