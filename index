/* ---------- engine ---------- */
var idx=0, performed=false;
var coach=$('coach'), pulse=$('pulse');

function render(){
  var s=S[idx];
  performed = !s.act;
  if(s.pre) s.pre();
  coach.classList.toggle('wide',!!s.wide);
  $('c-n').textContent='STEP '+(idx+1)+' OF '+S.length;
  $('c-t').textContent=s.t;
  var h=s.b||'';
  if(s.bp){ h+='<div class="bpbox"><b>HEADER IMAGE BEST PRACTICES</b><ul><li>'+s.bp.join('</li><li>')+'</li></ul></div>'; }
  if(s.stop){ h+='<div class="stopbox"><b><svg width="16" height="15" viewBox="0 0 20 18" fill="#C0392B"><path d="M10 0l10 18H0z"/></svg>STOP</b><p>'+s.stop+'</p></div>'; }
  if(s.tip){ h+='<div class="tipbox"><b>WHY IT MATTERS</b>'+s.tip+'</div>'; }
  $('c-b').innerHTML=h;
  $('c-b').scrollTop=0;
  $('c-p').textContent=(idx+1)+' / '+S.length;
  $('c-back').style.visibility = idx===0?'hidden':'visible';
  $('c-next').textContent = (idx===S.length-1)?'Finish':'Next step';
  $('c-next').disabled = !performed;
  $('bar-i').style.width = ((idx)/S.length*100)+'%';
  coach.classList.add('on');
  requestAnimationFrame(function(){ requestAnimationFrame(position); });
}

function targetEl(){ var s=S[idx]; return s.tgt?R.querySelector(s.tgt):null; }

function position(){
  var s=S[idx], el=targetEl();
  if(!el){ pulse.style.display='none'; centreCoach(); return; }
  if(s.scroll){ try{ el.scrollIntoView({block:'nearest',inline:'nearest'}); }catch(e){} }
  var r=el.getBoundingClientRect();
  if(r.width===0&&r.height===0){ pulse.style.display='none'; centreCoach(); return; }
  pulse.style.display='block';
  pulse.style.left=(r.left-4)+'px'; pulse.style.top=(r.top-4)+'px';
  pulse.style.width=(r.width+8)+'px'; pulse.style.height=(r.height+8)+'px';

  var cw=coach.offsetWidth, ch=coach.offsetHeight, gap=18, L, T;
  var vw=window.innerWidth, vh=window.innerHeight;
  var pos=s.pos||'right';
  if(pos==='right'){ L=r.right+gap; T=r.top-10; }
  else if(pos==='left'){ L=r.left-cw-gap; T=r.top-10; }
  else if(pos==='below'){ L=r.left+r.width/2-cw/2; T=r.bottom+gap; }
  else { L=r.left+r.width/2-cw/2; T=r.top-ch-gap; }
  if(L+cw>vw-12) L=Math.min(r.left-cw-gap, vw-cw-12);
  if(L<12) L=Math.min(r.right+gap, vw-cw-12);
  if(L<12) L=12;
  if(T+ch>vh-12) T=vh-ch-12;
  if(T<12) T=12;
  coach.style.left=L+'px'; coach.style.top=T+'px';
}

function centreCoach(){
  coach.style.left=Math.max(12,(window.innerWidth-coach.offsetWidth)/2)+'px';
  coach.style.top=Math.max(12,(window.innerHeight-coach.offsetHeight)/2)+'px';
}

function doAct(){
  var s=S[idx];
  if(performed) return;
  if(s.act) s.act();
  performed=true;
  $('c-next').disabled=false;
  requestAnimationFrame(function(){ requestAnimationFrame(position); });
}

function next(){
  if(!performed) return;
  if(idx===S.length-1){ finish(); return; }
  idx++; render();
}
function back(){
  if(idx===0) return;
  var target=idx-1;
  reset(); idx=0;
  for(var k=0;k<target;k++){ if(S[k].act) S[k].act(); }
  idx=target; render();
  performed = !S[idx].act;
  $('c-next').disabled=!performed;
}
function finish(){
  $('bar-i').style.width='100%';
  coach.classList.remove('on'); pulse.style.display='none';
  on('done',true);
}

/* delegate clicks on targets */
R.addEventListener('click',function(e){
  var s=S[idx]; if(!s||!s.tgt) return;
  var el=targetEl(); if(!el) return;
  if(el===e.target||el.contains(e.target)){
    var wasPerformed=performed;
    doAct();
    if(s.auto&&!wasPerformed){ setTimeout(next,340); }
  }
},true);

/* extra affordances inside the sim */
$('cop-ok').addEventListener('click',function(){ on('cop',false); });
$('pv-close').addEventListener('click',function(){ on('pv',false); });
function dev(btn,cls,dim){
  ['pv-desk','pv-tab','pv-mob'].forEach(function(k){$(k).classList.remove('on');});
  $(btn).classList.add('on');
  $('pv-frame').className='pv-frame'+(cls?' '+cls:'');
  $('pv-dim').textContent=dim;
  requestAnimationFrame(position);
  setTimeout(position,80);
}
$('pv-desk').addEventListener('click',function(){dev('pv-desk','','1104 \u00d7 439');});
$('pv-tab').addEventListener('click',function(){dev('pv-tab','tab','768 \u00d7 1024');});
$('pv-mob').addEventListener('click',function(){dev('pv-mob','mob','390 \u00d7 844');});

$('c-next').addEventListener('click',next);
$('c-back').addEventListener('click',back);
$('quit').addEventListener('click',function(){ start(); });
$('done-restart').addEventListener('click',function(){ on('done',false); start(); });
$('done-close').addEventListener('click',function(){ on('done',false); $('app').classList.remove('on'); $('sp').style.display='flex'; $('quit').style.display='none'; $('bar-i').style.width='0'; });

$('go').addEventListener('click',start);

function start(){
  $('sp').style.display='none';
  $('app').classList.add('on');
  $('quit').style.display='block';
  reset(); idx=0; render();
}

window.addEventListener('resize',function(){ requestAnimationFrame(position); });
$('main').addEventListener('scroll',function(){ requestAnimationFrame(position); },true);
$('rail-b').addEventListener('scroll',function(){ requestAnimationFrame(position); });
$('canvas').addEventListener('scroll',function(){ requestAnimationFrame(position); });

})();
</script>
